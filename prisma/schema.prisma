// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TENANT
  ADMIN
  OWNER
}

enum PropertyCategory {
  PROPERTY
  EQUIPMENT
}

enum PropertyStatus {
  AVAILABLE
  PAUSED
  DELETED
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
  CANCELED
}

enum DepositStatus {
  PENDING
  RETURNED
  RETAINED
  PARTIALLY_RETAINED
}

enum ReviewType {
  RENTER_TO_PROPERTY
  OWNER_TO_RENTER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role     @default(TENANT)
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  profile         Profile? //permite que sea opcional
  ownedProperties Property[]     @relation("PropertyOwner")
  tenantBookings  Booking[]      @relation("BookingTenant")
  depositsDecided Deposit[]      @relation("DepositDecidedBy")
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewTargetUser")

  @@map("users")
}

model Profile {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @unique @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isVerified Boolean @default(false) @map("is_verified")

  @@map("profiles")
}

model LoginAttempt {
  keyHash         String    @id @map("key_hash")
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")
  expiresAt       DateTime  @map("expires_at")

  @@index([expiresAt])
  @@map("login_attempts")
}

model Property {
  id              String           @id @default(uuid()) @db.Uuid
  ownerId         String           @map("owner_id") @db.Uuid
  owner           User             @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  title           String           @db.VarChar(100)
  description     String
  category        PropertyCategory
  department      String
  municipality    String
  address         String
  pricePerDay     Decimal          @map("price_per_day") @db.Decimal(10, 2)
  securityDeposit Decimal          @map("security_deposit") @db.Decimal(10, 2)
  images          String[]         @default([])
  status          PropertyStatus   @default(AVAILABLE)
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  bookings Booking[]
  reviews  Review[]

  @@index([ownerId, status])
  @@map("properties")
}

model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  propertyId String        @map("property_id") @db.Uuid
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenantId   String        @map("tenant_id") @db.Uuid
  tenant     User          @relation("BookingTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  startDate  DateTime      @map("start_date") @db.Date
  endDate    DateTime      @map("end_date") @db.Date
  subtotal   Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(PENDING)
  expiresAt  DateTime      @map("expires_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  deposit Deposit?
  reviews Review[]

  @@index([tenantId, status])
  @@index([propertyId, status])
  @@map("bookings")
}

model Review {
  id             String     @id @default(uuid()) @db.Uuid
  reservationId  String     @map("reservation_id") @db.Uuid
  reservation    Booking    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  propertyId     String     @map("property_id") @db.Uuid
  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  authorId       String     @map("author_id") @db.Uuid
  author         User       @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetUserId   String     @map("target_user_id") @db.Uuid
  targetUser     User       @relation("ReviewTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  reviewType     ReviewType @map("review_type")
  propertyRating Int?       @map("property_rating")
  userRating     Int        @map("user_rating")
  comment        String?    @db.VarChar(200)
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([propertyId, reviewType])
  @@index([targetUserId, reviewType])
  @@map("reviews")
}

model Deposit {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @unique @map("booking_id") @db.Uuid
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  decidedById    String?       @map("decided_by_id") @db.Uuid
  decidedBy      User?         @relation("DepositDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  amount         Decimal       @db.Decimal(10, 2)
  state          DepositStatus @default(PENDING)
  retainedAmount Decimal       @default(0) @map("retained_amount") @db.Decimal(10, 2)
  returnedAmount Decimal       @default(0) @map("returned_amount") @db.Decimal(10, 2)
  decidedAt      DateTime?     @map("decided_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([state])
  @@map("deposits")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
